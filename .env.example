# Copy to .env and fill in values
GROQ_API_KEY=your_groq_api_key_here

# Postgres (used inside Docker)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=insights
POSTGRES_USER=insights_user
POSTGRES_PASSWORD=insights_pass

# App
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change_me_in_production

# Chroma
CHROMA_HOST=chroma
CHROMA_PORT=8000
